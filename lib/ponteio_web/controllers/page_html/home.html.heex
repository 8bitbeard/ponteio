<Layouts.flash_group flash={@flash} />

<div class="hero min-h-[80vh]">
  <div class="hero-content text-center">
    <div class="max-w-xl">
      <div class="flex items-center justify-center gap-3">
        <img src={~p"/images/logo.svg"} width="40" class="text-primary" />
        <span class="text-2xl font-semibold tracking-tight">Ponteio</span>
      </div>

      <h1 class="mt-6 text-4xl font-bold tracking-tight text-balance">
        Transforme suas tablaturas em partituras de acordes prontas para tocar.
      </h1>

      <p class="mt-4 text-base-content/70 leading-7">
        A Ponteio analisa a tablatura do seu violão ou guitarra e sugere os
        acordes mais fáceis de encaixar, para você estudar e tocar com mais
        fluidez.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <.link navigate={~p"/sign-in"} class="btn btn-primary btn-lg" id="home-sign-in-cta">
          Entrar
        </.link>
        <.link navigate={~p"/register"} class="btn btn-outline btn-lg" id="home-register-cta">
          Cadastrar
        </.link>
      </div>
    </div>
  </div>
</div>
