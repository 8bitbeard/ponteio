# Copie este arquivo para `.env` e ajuste se necessário antes de rodar
# `docker compose up`. Valores abaixo são os defaults usados em desenvolvimento
# e batem com os defaults de config/dev.exs / config/test.exs.

# --- Banco de dados (serviço `db` no docker-compose.yml) ---
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ponteio_dev
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Phoenix (serviço `app` no docker-compose.yml) ---
PHX_HOST=localhost
PORT=4000
# Gere um valor novo com `mix phx.gen.secret` para ambientes que não sejam
# desenvolvimento local.
SECRET_KEY_BASE=insecure_dev_secret_key_base_change_me_insecure_dev_secret

# --- Login social com Google (issue #5) ---
# Credenciais do OAuth client "Web application" criado no Google Cloud
# Console — veja a seção "Login social com Google" no README para o
# passo a passo e a URL de callback a autorizar. Sem estes dois valores
# definidos, o botão "Entrar com Google" aparece na tela de login mas o
# fluxo falha ao tentar trocar o código por um token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
